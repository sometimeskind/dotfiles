// niri config — starter for the Bluefin/Fedora Atomic laptop.
//
// DankMaterialShell (DMS) provides the desktop shell layer (bar, spotlight
// launcher, notifications, lock screen, OSD). The four include files below
// are gitignored machine state (colors regenerate from the wallpaper);
// generate them BEFORE stowing this config — see README "Fedora Atomic
// laptop" step 3: per-file `dms setup` subcommands, skipping files the
// running shell already created. Bare `dms setup` would overwrite this
// file through the stow symlink. Our binds block below wins over duplicates in
// the generated dms/binds.kdl (niri includes are last-wins).
// Docs: https://danklinux.com/docs/dankmaterialshell/compositors

include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"

input {
    keyboard {
        xkb {
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// DMS (the desktop shell) is NOT spawned here: the ublue-niri image enables
// the dms.service user unit globally (restart-on-crash, journalctl --user -u
// dms), pulled in via graphical-session.target when niri-session starts.
// Clipboard history for the DMS clipboard widget.
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"

// Quickshell surfaces (DMS) render inside the overview backdrop.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

binds {
    // DMS shell binds (spotlight, lock, notifications, audio/brightness keys)
    // come from dms/binds.kdl — keep this block to compositor and app binds.
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Terminal (Ptyxis)" { spawn "ptyxis" "--new-window"; }
    Mod+B hotkey-overlay-title="Browser (Zen)" { spawn "flatpak" "run" "app.zen_browser.zen"; }
    Mod+Shift+A hotkey-overlay-title="Claude Code (~/src)" { spawn "ptyxis" "--new-window" "--" "bash" "-lc" "cd ~/src && exec claude"; }

    Mod+Q { close-window; }
    Mod+O { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+J { move-window-down; }

    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Shift+Print hotkey-overlay-title="Region → annotate (swappy)" { spawn "bash" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }
    Mod+Print hotkey-overlay-title="Decode QR on screen → clipboard" { spawn "bash" "-c" "grim -g \"$(slurp)\" - | zbarimg --quiet --raw - | wl-copy --trim-newline"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
