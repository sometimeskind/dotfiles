# Claude Code project-local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo
*~

# Secrets — never commit these
*.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
.secrets

# Claude runtime data — not config. On a fresh machine stow folds ~/.claude
# into a single symlink to claude/.claude, so everything Claude Code writes
# (credentials, sessions, caches, plugins, ...) lands in this checkout.
# Ignore it all and allowlist only the tracked config entries.
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/hooks/
!claude/.claude/settings.json
!claude/.claude/skills/

# DMS-generated niri include files — machine state written by dms setup, not config
niri/.config/niri/dms/*.kdl

# DMS settings: only settings.json is config. The directory is stowed folded
# (one symlink) because DMS saves atomically via temp file + rename, which
# would replace a file-level symlink. Everything else DMS drops next to it
# (browser theme CSS, first-launch/changelog markers, plugins) is derived.
dms/.config/DankMaterialShell/*
!dms/.config/DankMaterialShell/settings.json
