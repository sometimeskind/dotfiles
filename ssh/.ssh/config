# Pilot laptop — always log in as core
Host pilot
  User core

# 1Password SSH agent — private keys live in 1Password, never on disk.
# ~/.1password/agent.sock exists on Linux and as a compatibility symlink
# on macOS (created by the 1Password desktop app), so one path works on both.
# Makes agent auth work outside shells too (IDEs, GUI git clients).
# Only when someone can answer the approval prompt (op-prompt-ok, 1password
# package): not on headless boxes (no agent; an unconditional IdentityAgent
# would also override a forwarded agent's SSH_AUTH_SOCK), not in SSH/mosh
# sessions, and not while the workstation screen is locked. Otherwise the
# prompt lands on a locked screen and ssh hangs.
Match exec "~/.local/bin/op-prompt-ok"
  IdentityAgent ~/.1password/agent.sock

# First match wins, so this applies only when the rule above didn't: a shell
# started at the desk (e.g. a multiplexer pane from login, later attached over
# SSH) still exports SSH_AUTH_SOCK=1Password socket — don't use it.
Match exec "test ${SSH_AUTH_SOCK:-none} = ~/.1password/agent.sock"
  IdentityAgent none
