# Pilot laptop — always log in as core
Host pilot
  User core

# 1Password SSH agent — private keys live in 1Password, never on disk.
# ~/.1password/agent.sock exists on Linux and as a compatibility symlink
# on macOS (created by the 1Password desktop app), so one path works on both.
# Makes agent auth work outside shells too (IDEs, GUI git clients).
# Guarded on socket existence: on headless boxes (pilot) there is no
# 1Password agent, and an unconditional IdentityAgent would override the
# SSH_AUTH_SOCK of a forwarded agent and break outbound ssh from them.
# Also skipped inside SSH/mosh sessions (SSH_CONNECTION set; mosh-server
# inherits it): the approval prompt would land on the workstation's locked
# screen and hang. ${SSH_CONNECTION+x} is "x" when set, empty when not — no
# spaces, so it needs no quoting inside this already-quoted exec string.
Match exec "test -S ~/.1password/agent.sock && test -z ${SSH_CONNECTION+x}"
  IdentityAgent ~/.1password/agent.sock
