#!/usr/bin/env bash
set -euo pipefail

COOKIE_FILE=~/.config/spotdl/cookies.txt
OP_CLIENT_ID="op://Private/Spotify Developer App/client_id"
OP_CLIENT_SECRET="op://Private/Spotify Developer App/client_secret"

if [[ ! -f "$COOKIE_FILE" ]]; then
    echo "Error: YouTube Premium cookies not found at $COOKIE_FILE" >&2
    echo "See README for setup instructions." >&2
    exit 1
fi

if ! command -v op &>/dev/null; then
    echo "Error: 1Password CLI (op) not found" >&2
    exit 1
fi

echo "==> Fetching Spotify credentials from 1Password..."
SPOTIFY_CLIENT_ID=$(op read "$OP_CLIENT_ID")
SPOTIFY_CLIENT_SECRET=$(op read "$OP_CLIENT_SECRET")

echo "==> Creating Music directory structure..."
mkdir -p ~/Music/inbox/spotdl ~/Music/library ~/Music/quarantine ~/Music/playlists
echo "    ~/Music/inbox/spotdl"
echo "    ~/Music/library"
echo "    ~/Music/quarantine"
echo "    ~/Music/playlists"

echo ""
printf "Enter a name for this playlist (slug, e.g. liked-songs): "
read -r playlist_name

if [[ -z "$playlist_name" ]]; then
    echo "Error: playlist name required" >&2
    exit 1
fi

echo ""
printf "Enter the Spotify URL for '%s': " "$playlist_name"
read -r playlist_url

if [[ -z "$playlist_url" ]]; then
    echo "Error: playlist URL required" >&2
    exit 1
fi

SPOTDL_DIR=~/Music/inbox/spotdl
SPOTDL_FILE="$SPOTDL_DIR/$playlist_name.spotdl"

mkdir -p "$SPOTDL_DIR/$playlist_name"

echo ""
echo "==> Saving spotdl sync file for '$playlist_name'..."
spotdl --cookie-file "$COOKIE_FILE" \
    --client-id "$SPOTIFY_CLIENT_ID" \
    --client-secret "$SPOTIFY_CLIENT_SECRET" \
    save "$playlist_url" --save-file "$SPOTDL_FILE"

echo ""
echo "Setup complete."
echo "  Playlist    : $playlist_name"
echo "  Sync file   : $SPOTDL_FILE"
echo "  Download dir: $SPOTDL_DIR/$playlist_name/"
echo ""
echo "Run 'music-setup' again to add another playlist."
echo "Run 'music-ingest' to download and import all playlists."
