// Zellij config — install: brew install zellij
// Docs: https://zellij.dev/documentation/

// Keep session alive on force-close — essential for SSH use.
// Without this, closing the terminal would destroy the session.
on_force_close "detach"

// Status bar is visible by default — good while learning keybinds.
// To go minimal later, uncomment the two lines below:
pane_frames false

// Theme matching Ghostty's Argonaut colour scheme
theme "argonaut"

themes {
    argonaut {
        fg "#fffaf4"
        bg "#1a1a1a"
        black "#232323"
        red "#ff000f"
        green "#8ce10b"
        yellow "#ffb900"
        blue "#008df8"
        magenta "#6d43a6"
        cyan "#00d8eb"
        white "#ffffff"
        orange "#f37f00"
    }
}

// Custom keybindings — Normal mode additions and conflict resolution.
//
// Claude Code conflict fixes:
//   Ctrl+O  → Zellij Session mode    conflicts with Claude Code verbose toggle
//   Ctrl+T  → Zellij Tab mode        conflicts with Claude Code task list toggle
//   Ctrl+G  → Zellij Lock mode       conflicts with Claude Code open-in-editor
//
// Each conflicting Ctrl key is unbound from Normal mode so it passes through to
// Claude Code (or any other inner app). Zellij equivalents are remapped to Alt keys
// that are not used by Claude Code on Linux:
//   Alt+O → Session mode
//   Alt+backtick → Tab mode
//   (Lock mode removed — all conflicts resolved, lock is no longer needed)
//
// Pane splits (iTerm2-style):
//   Alt+D → split right, Alt+Shift+D → split down.
keybinds {
    normal {
        // Pane splits
        bind "Alt d" { NewPane "Right"; }
        bind "Alt D" { NewPane "Down"; }

        // Free Ctrl+O/T/G for Claude Code; remap Zellij actions to Alt keys
        unbind "Ctrl o"
        bind "Alt o" { SwitchToMode "Session"; }

        unbind "Ctrl t"
        bind "Alt `" { SwitchToMode "Tab"; }

        unbind "Ctrl g"
    }
}
