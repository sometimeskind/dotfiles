// Dev layout: editor (left, wide) + terminal (top-right) + logs (bottom-right)
// Usage: zellij --layout dev
//        or: zellij action new-tab --layout dev

layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="vertical" {
        // Main editor pane — takes 65% of the width
        pane size="65%" focus=true {
            name "editor"
        }
        // Right column split horizontally
        pane split_direction="horizontal" {
            // Terminal for running commands
            pane {
                name "terminal"
            }
            // Log tail / test output
            pane {
                name "logs"
            }
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
