# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
font-family = MesloLGS Nerd Font Mono
font-size = 13
background-opacity = 1.0
theme = Argonaut

# ── tmux pane ownership ───────────────────────────────────────────────────────
# tmux owns all splits and tabs. Ghostty's native splits are disabled to
# avoid accidental nesting (Ghostty panes die on window close; tmux panes
# persist across SSH disconnects).

# Hide the tab bar on Linux/GTK — tmux provides its own window UI.
# On macOS the tab bar only appears when >1 tab exists, so this isn't needed.
gtk-tabs-location = hidden

# Unbind Ghostty's native split and new-tab shortcuts.
# The exact defaults were verified via: ghostty +show-config --default --docs
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+t=unbind
