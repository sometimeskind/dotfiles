#!/bin/sh
# Put the GitHub token in gh's hosts.yml on tmpfs (sometimeskind/homelab#2178).
#
# ~/.config/gh/hosts.yml is a symlink to $XDG_RUNTIME_DIR/gh/hosts.yml, so
# every gh and git call (gh auth git-credential) in every pane reads it,
# including a pane opened over mosh while the screen is locked, and the token
# is gone at logout or reboot. Only this script writes the file: gh auth
# login/switch/logout may replace the symlink with a regular file on disk.
# GH_TOKEN must stay unset, because it overrides hosts.yml.
#
#   gh-token-fill           fill if empty (.zshrc preexec)
#   gh-token-fill --unlock  same, but at most one 1Password prompt per unlock
#                           (gh-token-fill.timer, so a token is there before
#                           you walk away, even if no pane was used)
#   gh-token-fill --force   re-read now, e.g. after rotating the PAT
#
# Exit 0: the token file is in place. 1: nobody can answer a prompt, try
# again later. 2: the read was tried and failed.
set -eu

OP_REF=${GH_TOKEN_OP_REF:-op://pilot-infra/Homelab PAT/token}
RUN_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gh
HOSTS=$HOME/.config/gh/hosts.yml
SA_TOKEN_FILE=$HOME/.config/op/service-account-token
TRIED=$RUN_DIR/tried-this-unlock
mode=${1-}

# pilot: gh-app-token owns hosts.yml (homelab#2139).
[ ! -x "$HOME/.local/bin/gh-app-token" ] || exit 0

filled() {
  [ -s "$RUN_DIR/hosts.yml" ] && [ "$(readlink "$HOSTS" 2>/dev/null)" = "$RUN_DIR/hosts.yml" ]
}

link() {
  if [ -e "$HOSTS" ] && [ ! -L "$HOSTS" ]; then
    echo "gh-token-fill: $HOSTS is a regular file (gh auth login?); move it away so the token stays off disk" >&2
    return 2
  fi
  mkdir -p "${HOSTS%/*}"
  ln -sfn "$RUN_DIR/hosts.yml" "$HOSTS"
}

[ "$mode" = --force ] || ! filled || exit 0

mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
# The timer and a shell can run at once: one prompt, not two.
exec 9>"$RUN_DIR/lock"
! command -v flock >/dev/null 2>&1 || flock 9
[ "$mode" = --force ] || ! filled || exit 0
# Filled earlier but the symlink was lost: relink, no read needed.
if [ "$mode" != --force ] && [ -s "$RUN_DIR/hosts.yml" ]; then
  link
  exit
fi

if [ -n "${OP_SERVICE_ACCOUNT_TOKEN-}" ]; then
  : # headless box: the exported service account never prompts
elif "$HOME/.local/bin/op-prompt-ok" 2>/dev/null; then
  if [ "$mode" = --unlock ]; then
    [ ! -e "$TRIED" ] || exit 1
    : >"$TRIED"
  fi
else
  # The timer saw a locked screen, so the next unlock may prompt once more.
  [ "$mode" != --unlock ] || rm -f "$TRIED"
  [ -f "$SA_TOKEN_FILE" ] || exit 1
  OP_SERVICE_ACCOUNT_TOKEN=$(cat "$SA_TOKEN_FILE")
  export OP_SERVICE_ACCOUNT_TOKEN
fi

# </dev/null: with no account configured, op read prompts on the terminal
# instead of failing; EOF makes it error out fast.
token=$(op read "$OP_REF" 2>/dev/null </dev/null) || token=
if [ -z "$token" ]; then
  echo "gh-token-fill: could not read $OP_REF" >&2
  exit 2
fi
user=$(GH_TOKEN=$token gh api user --jq .login 2>/dev/null) || user=

# Top-level oauth_token/user is the form gh reads for a token in hosts.yml
# (insecure storage); written whole and renamed so gh never reads half a file.
(
  umask 077
  {
    printf 'github.com:\n    oauth_token: %s\n' "$token"
    [ -z "$user" ] || printf '    user: %s\n' "$user"
    printf '    git_protocol: https\n'
  } >"$RUN_DIR/hosts.yml.tmp"
  mv "$RUN_DIR/hosts.yml.tmp" "$RUN_DIR/hosts.yml"
)
link
