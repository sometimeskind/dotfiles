{
  "permissions": {
    "allow": [
      "Bash(git restore:*)"
    ]
  },
  "model": "fable[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dash-separators.sh"
          },
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -q 'git push' && [[ $(git branch --show-current) == 'main' || $(git branch --show-current) == 'trunk' ]]; then echo 'BLOCK: Currently on main/trunk branch. Switch to a feature branch first.' && exit 1; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/nvim-sync.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dash-separators.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-admin-kubeconfig.sh"
          },
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -q 'git push' && [[ $(git branch --show-current) == 'main' || $(git branch --show-current) == 'trunk' ]]; then echo 'BLOCK: Currently on main/trunk branch. Switch to a feature branch first.' && exit 1; fi"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v moshi-hook >/dev/null && moshi-hook claude-hook || true",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "auto",
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(kubectl kustomize:*)",
      "Bash(kubectl apply --dry-run=client:*)",
      "Bash(kubectl port-forward -n sealed-secrets svc/sealed-secrets:*)",
      "Bash(gh pr checks:*)",
      "Bash(terraform -chdir=talos fmt -check -recursive)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(talosctl upgrade-k8s:*)",
      "Bash(talosctl upgrade:*)",
      "Bash(kubectl delete -n argocd:*)"
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  }
}
